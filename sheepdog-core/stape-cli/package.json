{
  "name": "@stape/cli",
  "version": "1.0.0",
  "description": "Unified CLI for Stape ecosystem - GTM, sGTM, CAPI & More",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stape": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublish": "npm run build"
  },
  "keywords": [
    "gtm",
    "stape",
    "server-side-tagging",
    "analytics",
    "tracking",
    "capi",
    "conversions-api",
    "ga4"
  ],
  "author": "Stape",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "conf": "^12.0.0",
    "inquirer": "^8.2.6",
    "ora": "^8.0.1",
    "table": "^6.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
