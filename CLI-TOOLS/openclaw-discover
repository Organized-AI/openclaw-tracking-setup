#!/usr/bin/env bash
# 🦞 OpenClaw Discover — Site crawl + tracking opportunity identification
# Uses Playwright MCP or Firecrawl for page analysis

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

show_help() {
  print_header "Discover"
  echo
  echo -e "${BOLD}USAGE${RESET}"
  echo -e "  openclaw discover ${CYAN}<url>${RESET} ${DIM}[options]${RESET}"
  echo
  echo -e "${BOLD}OPTIONS${RESET}"
  echo -e "  ${DIM}--depth <n>${RESET}      Max crawl depth (default: 2)"
  echo -e "  ${DIM}--output <file>${RESET}  Output YAML report path"
  echo -e "  ${DIM}--format <fmt>${RESET}   Output format: yaml, json, markdown (default: yaml)"
  echo
  echo -e "${BOLD}WHAT IT DOES${RESET}"
  echo -e "  Crawls the target URL and identifies:"
  echo -e "  • Buttons and CTAs (click triggers)"
  echo -e "  • Forms (submit triggers)"
  echo -e "  • Video players (engagement triggers)"
  echo -e "  • Scroll depth targets"
  echo -e "  • Outbound links"
  echo -e "  • File downloads"
  echo -e "  • Existing dataLayer pushes"
  echo -e "  • Existing tracking pixels/scripts"
  echo
  echo -e "${BOLD}EXAMPLES${RESET}"
  echo -e "  ${DIM}# Crawl a site${RESET}"
  echo -e "  openclaw discover https://example.com"
  echo
  echo -e "  ${DIM}# Deep crawl with JSON output${RESET}"
  echo -e "  openclaw discover https://example.com --depth 3 --format json"
}

# ── Parse options ───────────────────────────────────────────────────────────
DEPTH=2
OUTPUT=""
FORMAT="yaml"
URL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --depth) DEPTH="$2"; shift 2 ;;
    --output) OUTPUT="$2"; shift 2 ;;
    --format) FORMAT="$2"; shift 2 ;;
    --help|-h) show_help; exit 0 ;;
    -*) log_error "Unknown option: $1"; exit 1 ;;
    *) URL="$1"; shift ;;
  esac
done

if [[ -z "$URL" ]]; then
  log_error "URL required."
  echo
  show_help
  exit 1
fi

# ── Default output path ────────────────────────────────────────────────────
if [[ -z "$OUTPUT" ]]; then
  DOMAIN=$(echo "$URL" | sed 's|https\?://||' | sed 's|/.*||' | sed 's|[^a-zA-Z0-9]|-|g')
  OUTPUT="${OPENCLAW_OUTPUT}/discovery-${DOMAIN}-$(date +%Y%m%d-%H%M%S).${FORMAT}"
fi

print_header "Discovery"
echo
log_step "Target: ${BOLD}$URL${RESET}"
log_step "Depth: $DEPTH"
log_step "Format: $FORMAT"
log_step "Output: $OUTPUT"
echo

# ── Step 1: Scrape the page ─────────────────────────────────────────────────
log_step "Scraping page content..."

# Use firecrawl if available, otherwise fall back to curl + basic parsing
PAGE_CONTENT=$(mcp_call firecrawl.firecrawl_scrape \
  url:"$URL" \
  'formats:["markdown"]' \
  onlyMainContent:false 2>/dev/null || echo "SCRAPE_FAILED")

if [[ "$PAGE_CONTENT" == "SCRAPE_FAILED" ]]; then
  log_warn "Firecrawl not available. Using basic scrape."
  PAGE_CONTENT="{\"note\": \"Basic scrape mode — connect Firecrawl MCP for full analysis\"}"
fi

log_ok "Page scraped"

# ── Step 2: Map the site ────────────────────────────────────────────────────
if [[ $DEPTH -gt 1 ]]; then
  log_step "Mapping site URLs (depth: $DEPTH)..."
  SITE_MAP=$(mcp_call firecrawl.firecrawl_map \
    url:"$URL" \
    limit:50 2>/dev/null || echo "[]")
  log_ok "Site mapped"
fi

# ── Step 3: Generate discovery report ───────────────────────────────────────
log_step "Generating discovery report..."

cat > "$OUTPUT" << 'REPORT_HEADER'
# OpenClaw Discovery Report
# Generated by: openclaw discover
REPORT_HEADER

cat >> "$OUTPUT" << REPORT_META
# URL: $URL
# Date: $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Depth: $DEPTH

REPORT_META

if [[ "$FORMAT" == "yaml" ]]; then
  cat >> "$OUTPUT" << 'YAML_TEMPLATE'
site:
  url: "PLACEHOLDER_URL"
  pages_crawled: 0
  
tracking_existing:
  gtm_containers: []
  ga4_properties: []
  meta_pixels: []
  other_scripts: []

opportunities:
  - page: "/"
    elements:
      - type: button
        selector: ""
        text: ""
        action: click
        priority: high
        recommended:
          tag: "GA4 Event"
          trigger: "Click - CTA Button"
          event_name: "cta_click"

  - page: "/"
    elements:
      - type: form
        selector: ""
        action: submit
        priority: high
        recommended:
          tag: "GA4 Event + Meta CAPI"
          trigger: "Form Submission"
          event_name: "generate_lead"

scroll_depth_targets:
  - 25%
  - 50%
  - 75%
  - 90%

video_players:
  detected: false
  platforms: []

outbound_links:
  count: 0
  domains: []

next_steps:
  - "Run: openclaw gtm audit"
  - "Create tags from opportunities"
  - "Run: openclaw preview <url>"
  - "Run: openclaw qa run <story.yaml>"
YAML_TEMPLATE

  # Replace placeholder
  sed -i "s|PLACEHOLDER_URL|$URL|g" "$OUTPUT" 2>/dev/null || \
    sed -i '' "s|PLACEHOLDER_URL|$URL|g" "$OUTPUT" 2>/dev/null || true
fi

echo
log_ok "Discovery report saved: ${BOLD}$OUTPUT${RESET}"
log_dim "Edit the report to fill in detected elements, then run:"
log_dim "  openclaw gtm audit"
log_dim "  openclaw preview $URL"
